# Copy to .env.local (git-ignored) and fill in from the group chat.

# Supabase: client and server. Also set both in Vercel (the /api function reads them from process.env).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Claude API key: server only, set in Vercel, never VITE_ (a VITE_ prefix ships it to every browser).
ANTHROPIC_API_KEY=
